<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.manage2.mapper.ProjectStageTaskMapper">

    <select id="findByProjectId" resultType="com.example.manage2.entity.ProjectStageTask">
        SELECT *
        FROM "project_stage_task"
        WHERE "project_id" = #{projectId}
        ORDER BY "plan_start_date" ASC
    </select>


    <insert id="insertTask" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO "project_stage_task" (
            "project_id", "stage_dict_code", "task_name",
            "plan_start_date", "plan_end_date", "plan_workload",
            "actual_start_date", "actual_end_date", "actual_workload",
            "responsible_id", "responsible_person",
            "participant_ids", "participants",
            "status_dict_code", "issues", "rectification_measures", "remarks", "attachment_urls"
        )
        VALUES (
                   #{projectId}, #{stageDictCode}, #{taskName},
                   #{planStartDate}, #{planEndDate}, #{planWorkload},
                   #{actualStartDate}, #{actualEndDate}, #{actualWorkload},
                   #{responsibleId}, #{responsiblePerson},
                   #{participantIds}, #{participants},
                   #{statusDictCode}, #{issues}, #{rectificationMeasures}, #{remarks}, #{attachmentUrls}
               )
    </insert>

    <update id="updateTask">
        UPDATE "project_stage_task"
        SET "stage_dict_code"        = #{stageDictCode},
            "task_name"              = #{taskName},
            "plan_start_date"        = #{planStartDate},
            "plan_end_date"          = #{planEndDate},
            "plan_workload"          = #{planWorkload},
            "actual_start_date"      = #{actualStartDate},
            "actual_end_date"        = #{actualEndDate},
            "actual_workload"        = #{actualWorkload},
            "responsible_id"         = #{responsibleId},
            "responsible_person"     = #{responsiblePerson},
            "participant_ids"        = #{participantIds},
            "participants"           = #{participants},
            "status_dict_code"       = #{statusDictCode},
            "issues"                 = #{issues},
            "rectification_measures" = #{rectificationMeasures},
            "remarks"                = #{remarks},
            "attachment_urls"        = #{attachmentUrls}
        WHERE "id" = #{id}
    </update>


    <delete id="deleteTask">
        DELETE FROM "project_stage_task"
        WHERE "id" = #{id}
    </delete>

    <delete id="deleteTaskByProjectId">
        DELETE FROM "project_stage_task"
        WHERE "project_id" = #{id}
    </delete>

</mapper>