<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.manage2.mapper.SysUserMapper">

    <select id="findByUsername" resultType="com.example.manage2.entity.SysUser">
        SELECT "id",
               "username",
               "password",
               "real_name"   AS realName,
               "status",
               "create_time" AS createTime
        FROM "sys_user"
        WHERE "username" = #{username}
    </select>
    <insert id="insertUser" parameterType="com.example.manage2.entity.SysUser">
        INSERT INTO "sys_user" ("id", "username", "password", "real_name", "status", "create_time")
        VALUES (#{id}, #{username}, #{password}, #{realName}, #{status}, #{createTime})
    </insert>

</mapper>